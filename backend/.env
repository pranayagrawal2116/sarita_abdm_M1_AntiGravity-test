SCAN_SHARE_HIP_ID=IN2410002480
SCAN_SHARE_HOSPITAL_NAME=Yashfeen Group of Hospitals
SCAN_SHARE_COUNTER_LABEL=Counter: 1

# HIU ID:
# - Where to enter: here in backend/.env
# - How to get: from ABDM HIU onboarding credentials.
# - Why needed: safer for Discover/Consent flows than relying on fallback.
HIU_ID=IN2410002480

# JWS signing key id:
# - Where to enter: here in backend/.env
# - How to get: the registered key id (kid) for your HIU signing key.
