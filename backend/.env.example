
# ABDM gateway app credentials.
# How to get:
# - From ABDM onboarding credentials for your sandbox/prod application.
# - These are the same values used to create gateway sessions (/sessions).
ABDM_CLIENT_ID=SBX_XXXXXX
ABDM_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ABDM base URLs.
# Sandbox values are usually:
# - GATEWAY_BASE=https://dev.abdm.gov.in
# - Abha_BASE=https://Abhasbx.abdm.gov.in
GATEWAY_BASE=https://dev.abdm.gov.in
Abha_BASE=https://Abhasbx.abdm.gov.in
FACILITY_BASE=https://facilitysbx.abdm.gov.in
X_CM_ID=sbx

PORT=3000
HOST=0.0.0.0

# Hospital identity defaults used across the app.
HOSPITAL_SHORT_NAME=
FACILITY_NAME=
HOSPITAL_LEGAL_NAME=
BENEFIT_NAME=
REQUESTER_NAME=

# Public callback URL for ABDM webhooks.
# How to get:
# - Start a tunnel with: npm run tunnel
# - The tunnel script auto-updates backend/.env with the live public URL.
# - For a permanent setup, replace this with your own stable public domain.
PUBLIC_BASE_URL=https://your-public-callback-host.example.com

# Optional but strongly recommended defaults for M2.
# How to get:
# - HIP_ID: from ABDM HIP onboarding credentials for your facility/provider.
# - HIU_ID: from ABDM HIU onboarding credentials. If not set, some flows fall back
#   to ABDM_CLIENT_ID, but explicit HIU_ID is safer.
HIP_ID=IN2410029452
HIU_ID=IN2410029452
BRIDGE_ID=
FACILITY_ID=
FACILITY_NAME=

# Consent view (JWS) configuration
# ABDM sandbox/prod consent-view page.
# Only change this if ABDM gave you a different consent-view URL.
ABDM_CONSENT_VIEW_URL=https://consent.abdm.gov.in/view

# Optional key id (kid) for the HIU signing key.
# How to get:
# - From the HIU key registered during ABDM HIU onboarding.
ABDM_HIU_KEY_ID=

# Provide one of these two for JWS signing:
# How to get:
# - Use the private key corresponding to the HIU public key registered with ABDM.
# - If your org generated a keypair during onboarding, use that private key.
# - Keep this file outside version control.
ABDM_HIU_PRIVATE_KEY_PATH=./keys/hiu_private.pem
# ABDM_HIU_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
